<resources>

    <!-- Whether to cleanup fingerprints upon connection to the daemon and when
         user switches -->
    <bool name="config_cleanupUnusedFingerprints">true</bool>

    <!-- Whether to cancel fingerprint operation if not idle -->
    <bool name="config_fpCancelIfNotIdle">false</bool>

    <!-- Whether to allow process with media UID to access CameraServiceProxy -->
    <bool name="config_allowMediaUidForCameraServiceProxy">false</bool>

    <!-- Lockscreen rotation default -->
    <bool name="config_lockScreenRotationEnabledByDefault">false</bool>

    <!-- Whether to force enable multi resolution configuration for camera -->
    <bool name="config_forceMultiResolution">false</bool>

    <!-- Whether device supports an alt. ambient display -->
    <bool name="config_alt_ambient_display">false</bool>

    <!-- Default values for status bar DT2S gesture -->
     <bool name="config_dt2sGestureAvailable">true</bool>
     <bool name="config_dt2sGestureEnabledByDefault">true</bool>

    <!-- Overlays that to be enabled in FHD+ resolution -->
    <string-array name="config_fhdResolutionOverlays" translatable="false">
    </string-array>
</resources>
